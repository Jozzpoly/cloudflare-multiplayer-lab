{
  "name": "cloudflare-multiplayer-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "validate:worker": "wrangler deploy --dry-run --outdir .wrangler/dry-run",
    "check": "npm run typecheck && npm run validate:worker"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "wrangler": "4.127.1"
  },
  "engines": {
    "node": ">=22"
  }
}
