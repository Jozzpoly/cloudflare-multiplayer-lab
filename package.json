{
  "name": "cloudflare-multiplayer-lab",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --env staging",
    "deploy": "wrangler deploy",
    "deploy:staging": "wrangler deploy --env staging",
    "generate:types": "wrangler types --env staging",
    "check:client": "node --check public/app.js",
    "typecheck": "npm run generate:types && tsc --noEmit",
    "validate:worker": "wrangler deploy --dry-run --env staging --outdir .wrangler/dry-run",
    "check": "npm run check:client && npm run typecheck && npm run validate:worker"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "wrangler": "4.127.1"
  },
  "engines": {
    "node": ">=22"
  }
}
