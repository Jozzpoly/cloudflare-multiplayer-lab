{
  "name": "cloudflare-multiplayer-lab",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --env staging",
    "deploy": "wrangler deploy",
    "generate:types": "wrangler types --env staging",
    "typecheck": "npm run generate:types && tsc --noEmit",
    "check:client": "node --check public/app.js && node --check public/world0/app.js",
    "lab:a2r": "node scripts/a2r-forecast-lab.mjs",
    "check:a2r": "node scripts/a2r-forecast-lab.mjs --ci",
    "validate:worker": "wrangler deploy --dry-run --env staging --outdir .wrangler/dry-run",
    "check": "npm run check:client && npm run check:a2r && npm run typecheck && npm run validate:worker"
  },
  "dependencies": {
    "box3d.js": "0.1.1"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "wrangler": "4.127.1"
  },
  "engines": {
    "node": ">=22"
  }
}
