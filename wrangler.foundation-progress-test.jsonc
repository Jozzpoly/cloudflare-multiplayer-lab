{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "multi-world-foundation-progress-local-test",
  "main": "src/multiplayer-foundation/replication-progress-storage-test-worker.ts",
  "compatibility_date": "2026-08-29",
  "durable_objects": {
    "bindings": [
      {
        "name": "FOUNDATION_PROGRESS_TEST",
        "class_name": "FoundationProgressStorageTest"
      }
    ]
  },
  "exports": {
    "FoundationProgressStorageTest": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  }
}
