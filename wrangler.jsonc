{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "cloudflare-multiplayer-lab",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-29",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/room/*"]
  },
  "env": {
    "staging": {
      "name": "cloudflare-multiplayer-lab-staging",
      "workers_dev": true,
      "durable_objects": {
        "bindings": [
          {
            "name": "ROOMS",
            "class_name": "Room"
          }
        ]
      },
      "exports": {
        "Room": {
          "type": "durable-object",
          "storage": "sqlite"
        }
      }
    }
  }
}
