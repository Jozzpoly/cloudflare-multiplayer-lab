{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "cloudflare-multiplayer-lab",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-29",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/game/*"]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "WORLD",
        "class_name": "World"
      }
    ]
  },
  "exports": {
    "Room": {
      "type": "durable-object",
      "state": "deleted"
    },
    "World": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "env": {
    "staging": {
      "name": "cloudflare-multiplayer-lab-staging",
      "workers_dev": true,
      "assets": {
        "directory": "./public",
        "binding": "ASSETS",
        "run_worker_first": ["/api/*", "/game/*"]
      },
      "durable_objects": {
        "bindings": [
          {
            "name": "WORLD",
            "class_name": "World"
          }
        ]
      },
      "exports": {
        "Room": {
          "type": "durable-object",
          "state": "deleted"
        },
        "World": {
          "type": "durable-object",
          "storage": "sqlite"
        }
      }
    }
  }
}
