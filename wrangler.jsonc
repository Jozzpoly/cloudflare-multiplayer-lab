{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "cloudflare-multiplayer-lab",
  "main": "src/world-slice-entry.ts",
  "compatibility_date": "2026-08-29",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/game/*", "/world0/ws"]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "WORLD",
        "class_name": "World"
      },
      {
        "name": "WORLD_SLICE_0",
        "class_name": "WorldSlice0"
      }
    ]
  },
  "exports": {
    "Room": {
      "type": "durable-object",
      "state": "deleted"
    },
    "World": {
      "type": "durable-object",
      "storage": "sqlite"
    },
    "WorldSlice0": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "env": {
    "staging": {
      "name": "cloudflare-multiplayer-lab-staging",
      "workers_dev": true,
      "assets": {
        "directory": "./public",
        "binding": "ASSETS",
        "run_worker_first": ["/api/*", "/game/*", "/world0/ws", "/world0-f5/ws", "/world-v0/ws"]
      },
      "durable_objects": {
        "bindings": [
          {
            "name": "WORLD",
            "class_name": "World"
          },
          {
            "name": "WORLD_SLICE_0",
            "class_name": "WorldSlice0"
          },
          {
            "name": "WORLD_SLICE_F5",
            "class_name": "WorldSliceF5"
          },
          {
            "name": "SHARED_YARD_V0",
            "class_name": "SharedYardV0"
          }
        ]
      },
      "exports": {
        "Room": {
          "type": "durable-object",
          "state": "deleted"
        },
        "World": {
          "type": "durable-object",
          "storage": "sqlite"
        },
        "WorldSlice0": {
          "type": "durable-object",
          "storage": "sqlite"
        },
        "WorldSliceF5": {
          "type": "durable-object",
          "storage": "sqlite"
        },
        "SharedYardV0": {
          "type": "durable-object",
          "storage": "sqlite"
        }
      }
    }
  }
}
